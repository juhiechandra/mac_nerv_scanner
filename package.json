{
  "name": "nerv-scan",
  "version": "0.1.0",
  "description": "MAGI-driven macOS security scanner with a NERV-terminal TUI",
  "type": "module",
  "bin": {
    "nerv-scan": "./dist/cli/main.js"
  },
  "scripts": {
    "dev": "tsx src/cli/main.tsx",
    "build": "tsc -p tsconfig.json && chmod +x dist/cli/main.js",
    "start": "node dist/cli/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ink": "^5.0.1",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18"
  }
}
